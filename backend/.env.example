# Server
PORT=4000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DB_NAME

# Cloudinary (image upload)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Demo user accounts
USER_EMAIL=user@example.com
USER_PASSWORD=change_me
USER2_EMAIL=user2@example.com
USER2_PASSWORD=change_me

# Demo clinic/pharmacy account
KLINIKAPOTEK_EMAIL=clinic@example.com
KLINIKAPOTEK_PASSWORD=change_me
